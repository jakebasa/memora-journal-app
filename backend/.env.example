# =====================
# Database Configuration
# =====================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=yourapp
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority&appName=your_app

# =====================
# Authentication & Security
# =====================
# JWT secret for token signing (generate with: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_key_here

# =====================
# External APIs
# =====================
# Google Gemini AI API key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =====================
# Server Configuration
# =====================
# Port for the backend server (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# =====================
# Frontend Configuration
# =====================
# Frontend URL for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:3000
