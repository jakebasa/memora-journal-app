# =====================
# Database Configuration
# =====================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=yourapp
MONGO_URI=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/?retryWrites=true&w=majority&appName=your_app

# =====================
# Authentication & Security
# =====================
# JWT secret for token signing (generate with: openssl rand -hex 64)
JWT_SECRET=your_jwt_secret_key_here

# =====================
# External APIs
# =====================
# Google Gemini AI API key
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary configuration for image uploads
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =====================
# Server Configuration
# =====================
# Port for the backend server (default: 5000)
PORT=5000

# Node environment (development, production, test)
NODE_ENV=development

# =====================
# Frontend Configuration
# =====================
# Frontend URL for CORS (default: http://localhost:3000)
FRONTEND_URL=http://localhost:8080

# =====================
# Email Configuration
# =====================
# Email service for password reset functionality
# 
# Option 1: SendGrid (Recommended for production)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# FROM_EMAIL=noreply@yourdomain.com
#
# Option 2: Gmail (For development/testing)
# Create a dedicated Gmail account for your app
# Get app password from: https://myaccount.google.com/apppasswords
EMAIL_USER=memora.journal@gmail.com
EMAIL_PASS=fxgbihseicbpiyud
